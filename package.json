{
  "name": "nacenis-business",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "db:seed": "tsx -e \"import('dotenv/config').then(() => import('./src/db/seed.ts')).then(m => m.runSeed()).then(() => { console.log('Seed completed'); process.exit(0); })\"",
    "test": "node --test tests/api.test.ts"
  },
